node_modules/
__pycache__/
.venv/
*.pyc
# Glob, not the exact name: a .envx holding a provider key sat untracked and
# therefore committable for a whole session, because `.env` matched nothing else.
.env*
.DS_Store
results*.jsonl
.next/

# Raw sweep output — hundreds of MB of per-call rows, too large for git. Held on
# the Modal volume `nullcard-results`; scripts/results_manifest.py pins every
# file's SHA-256 so a copy can be verified as THE copy the paper was built from.
# card.json carries the analysis the paper and site actually read.
results/
# Same reason as results/, and easy to miss: the hosted tree is new, and
# `results*.jsonl` above does NOT cover it -- these files are named after the
# model (google__gemma-3-27b-it__R.jsonl), so nothing else here matches them.
results_hosted/
# Exact name on purpose. `sweep_summary.json` is the transient target every
# sweep overwrites; the config-named `sweep_summary__<cells>-<design>.json`
# files identify which sweep produced them and ARE tracked.
data/sweeps/sweep_summary.json
.netlify/

# LaTeX build intermediates. The PDFs and the GENERATED inputs
# (numbers.tex, table_main.tex, figs/*.pdf) are committed on purpose: results/
# is ignored, so they are the only way to rebuild the paper from a clean clone.
paper/*.aux
paper/*.log
paper/*.blg
paper/*.bbl
paper/*.out
paper/*.xdv
paper/*.nav
paper/*.snm
paper/*.toc
dist/
